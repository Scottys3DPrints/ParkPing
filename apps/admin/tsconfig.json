{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  // vite.config.ts is intentionally excluded: Vite transpiles it itself, and
  // typechecking it here resolves two different hoisted copies of Vite's types
  // (vitest pulls one to the workspace root) which conflict with each other.
  "include": ["src"]
}
