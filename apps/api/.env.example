# ParkPing API configuration.
# Copy to .env and fill in for a real deployment. Every value here has a
# development default, so `npm run dev` works with none of this set.

NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Unset: an embedded PostgreSQL (PGlite) is used, stored in ./.pgdata.
# Set: a real PostgreSQL server. Required in production. Host it in the EU.
# DATABASE_URL=postgresql://parkping:parkping@localhost:5432/parkping
# EMBEDDED_DB_PATH=./.pgdata

# --- Secrets ----------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate each one separately with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# PLATE_INDEX_PEPPER is the HMAC key behind every stored plate index.
# Rotating it makes every registered vehicle unroutable until re-indexed, and
# there is no migration path that avoids downtime. Treat it as permanent.
# PLATE_ENCRYPTION_KEY decrypts plates and contact addresses. Losing it means
# users can no longer be shown their own plate or receive a sign-in code.
# Back both up somewhere separate from the database.
# PLATE_INDEX_PEPPER=
# PLATE_ENCRYPTION_KEY=
# HANDLE_PEPPER=
# JWT_SECRET=

# --- Authentication ---------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Returns the sign-in code in the API response. Forced off in production.
OTP_ECHO=true

# --- Alert pipeline ---------------------------------------------------------
# Minimum duration of POST /v1/alerts, in ms. Pads every response to the same
# floor so response time cannot reveal whether a plate is registered. Set it
# above your p99 routed-alert latency; too low reopens the timing side channel.
ALERT_MIN_RESPONSE_MS=250
# Distinct plates one reporter may target per day before being flagged and
# silently suppressed. Tune against pilot data before raising.
ENUMERATION_DISTINCT_PLATES_PER_DAY=15

# --- Retention (days) -------------------------------------------------------
# Confirm these with counsel before a public launch; see docs/DECISIONS.md.
RETENTION_ALERT_DAYS=90
RETENTION_AUDIT_DAYS=180
RETENTION_ANALYTICS_DAYS=365
RETENTION_RATE_LIMIT_HOURS=48

# --- Push -------------------------------------------------------------------
# console: logs what would be sent. expo: real delivery via APNs + FCM.
PUSH_PROVIDER=console
# EXPO_ACCESS_TOKEN=

# --- Consent ----------------------------------------------------------------
# Bump to force every user to re-accept the terms on next sign-in.
CONSENT_VERSION=2026-08-30
